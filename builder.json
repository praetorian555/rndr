{
    "name": "rndr",
    "exclude": ["build", "samples/android"],
    "options": {
        "canvas": {"type": "bool", "default": {"windows": true, "*": false}, "description": "Canvas, the high-level API on OpenGL 4.5 through WGL; Windows only"},
        "forge": {"type": "bool", "default": false, "description": "Forge, the low-level API on Vulkan"},
        "forge-validation": {"type": "bool", "default": false, "description": "The Vulkan validation layer in Forge; needs the Vulkan SDK at run time"},
        "forge-vulkan-1-1": {"type": "bool", "default": false, "description": "Forge on Vulkan 1.1 and the extensions 1.2 and 1.3 promoted, for MoltenVK and older drivers"},
        "assimp": {"type": "bool", "default": true, "description": "Mesh and model loading through assimp"},
        "ktx": {"type": "bool", "default": true, "description": "KTX texture loading through KTX-Software"},
        "audio": {"type": "bool", "default": {"windows": true, "android": true, "*": false}, "description": "Clips, streams, a software mixer and a WASAPI or AAudio device"},
        "tests": {"type": "bool", "default": true, "description": "The rndr_test executable"},
        "samples": {"type": "bool", "default": true, "description": "The sample executables"}
    },
    "dependencies": {
        "opal": {
